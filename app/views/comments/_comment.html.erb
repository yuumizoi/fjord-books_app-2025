<div style="padding: 10px 0;">
  <p>
    <strong><%= comment.user.name_or_email %></strong>
    <span style="color: grey; font-size: 0.8em;"><%= time_ago_in_words(comment.created_at) %>前</span>
  </p>
  <p><%= simple_format(comment.content) %></p>

  <% if current_user == comment.user %>
    <%= link_to '削除', [comment.commentable, comment], data: { turbo_method: :delete, turbo_confirm: t('views.common.delete_confirm') }, style: "color: red;" %>
  <% end %>
</div>
